<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalog | The Indian Stone Art</title>
    <link rel="icon" href="favicon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #1a1512; --accent: #c5a059; --bg-light: #fdfbf7; }
        body { font-family: 'Montserrat', sans-serif; margin: 0; background-color: var(--bg-light); }
        header { background-color: var(--primary); padding: 1rem 2rem; border-bottom: 2px solid var(--accent); }
        .nav-container { max-width: 1200px; margin: auto; display: flex; justify-content: space-between; align-items: center; }
        .brand-title { font-family: 'Cinzel', serif; font-size: 1.3rem; color: #fff; text-decoration: none; }
        nav a { color: #dcd6cd; text-decoration: none; margin-left: 20px; font-size: 0.85rem; text-transform: uppercase; }
        nav a.active { color: var(--accent); }
        
        .section { max-width: 1200px; margin: auto; padding: 4rem 2rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; }
        .card { background: #fff; border: 1px solid #e5dfd5; padding: 1.5rem; text-align: center; box-shadow: 0 5px 15px rgba(0,0,0,0.03); }
        .card img { width: 100%; height: 230px; object-fit: contain; }
        .price { color: var(--accent); font-weight: 600; font-size: 1.2rem; margin: 10px 0; }
        .btn-order { background: #25D366; color: #fff; border: none; padding: 10px 18px; font-weight: bold; cursor: pointer; width: 100%; border-radius: 2px; }
        footer { background: var(--primary); color: #a39c94; text-align: center; padding: 2rem; margin-top: 3rem; }
    </style>
</head>
<body>

    <header>
        <div class="nav-container">
            <a href="index.html" class="brand-title">THE INDIAN STONE ART</a>
            <nav>
                <a href="index.html">Home</a>
                <a href="about.html">About Heritage</a>
                <a href="collection.html" class="active">Catalog</a>
                <a href="track.html">Track Order</a>
                <a href="login.html">Login</a>
            </nav>
        </div>
    </header>

    <div class="section">
        <h1 style="font-family:'Cinzel', serif; text-align:center; margin-bottom: 2rem;">Full Artisan Collection</h1>
        <div class="grid-3">
            <!-- Product 1 -->
            <div class="card">
                <img src="https://i.ibb.co/bRjX7450/file-000000008fcc622fb4a34f7f307de971.png" alt="Marble Diffuser">
                <h3>Marble Aroma Diffuser</h3>
                <div class="price">₹699</div>
                <button class="btn-order" onclick="orderNow('Marble Aroma Diffuser')">Order on WhatsApp</button>
            </div>
            <!-- Product 2 -->
            <div class="card">
                <img src="https://i.ibb.co/Nd9cZ3PZ/image-2.png" alt="Marble Jar">
                <h3>Handcrafted Marble Jar</h3>
                <div class="price">₹599</div>
                <button class="btn-order" onclick="orderNow('Handcrafted Marble Jar')">Order on WhatsApp</button>
            </div>
            <!-- Product 3 -->
            <div class="card">
                <img src="https://i.ibb.co/N6vNL3jd/1772187211766-2.jpg" alt="Marble Tray">
                <h3>Marble Decorative Tray</h3>
                <div class="price">₹5,200</div>
                <button class="btn-order" onclick="orderNow('Marble Decorative Tray')">Order on WhatsApp</button>
            </div>
            <!-- Product 4 (Aap aur products easily add kar sakte hain) -->
            <div class="card">
                <img src="https://i.ibb.co/8LBvrYXC/marble-cracker-dish.webp" alt="Marble Dish">
                <h3>Marble Cracker Dish</h3>
                <div class="price">₹850</div>
                <button class="btn-order" onclick="orderNow('Marble Cracker Dish')">Order on WhatsApp</button>
            </div>
        </div>
    </div>

    <footer><p>&copy; 2026 The Indian Stone Art.</p></footer>

    <script>
        function orderNow(item) {
            var msg = "*New Inquiry/Order - The Indian Stone Art*%0A%0A*Item:* " + encodeURIComponent(item);
            window.open("https://api.whatsapp.com/send?phone=919636567813&text=" + msg, '_blank');
        }
    </script>
</body>
</html>
